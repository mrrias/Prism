
{
    "compilerOptions": {
        "target": "ESNext",
        "module": "Node16",
        "moduleResolution": "Node16",

        "rootDir": "./src",
        "outDir": "./dist",

        "strict": true,
        "esModuleInterop": true,

        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,

        "skipLibCheck": true,
        "preserveConstEnums": true,

        "types": ["node"],

        "forceConsistentCasingInFileNames": true
    },

    "include": ["src/**/*.ts"],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.js"
    ]
}
